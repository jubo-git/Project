```stata
use "https://raw.githubusercontent.com/jubo-git/Project/main/2.%20data_clean/full_dataset.dta", clear
xtset ons_id year


* 2. EVENT STUDIES BY OUTCOME VARIABLE
* Base Year = 2019

**# hex_1y
xtreg hex_1y ib2019.year##c.total_tier, ///
    fe vce(cluster onscode)


**# hex_2y
xtreg hex_2y ib2019.year##c.total_tier, ///
    fe vce(cluster onscode)


**# mmr1_2y
xtreg mmr1_2y ib2019.year##c.total_tier, ///
    fe vce(cluster onscode)


**# hib_men_boost_2y
xtreg hib_men_boost_2y ib2019.year##c.total_tier, ///
    fe vce(cluster onscode)


**# hex_5y
xtreg hex_5y ib2019.year##c.total_tier, ///
    fe vce(cluster onscode)


**# dtp_boost_5y
xtreg dtp_boost_5y ib2019.year##c.total_tier, ///
    fe vce(cluster onscode)


**# mmr1_5y
xtreg mmr1_5y ib2019.year##c.total_tier, ///
    fe vce(cluster onscode)


**# mmr2_5y
xtreg mmr2_5y ib2019.year##c.total_tier, ///
    fe vce(cluster onscode)


**# hib_men_boost_5y
xtreg hib_men_boost_5y ib2019.year##c.total_tier, ///
    fe vce(cluster onscode)



**# PARALLEL TREND PLOTS BY QUARTILE — GROUPED BY OUTCOME VARIABLE


**# hex_1y
bysort tier_quartile year: egen mean_tier_hex1y = mean(hex_1y)

twoway (line mean_tier_hex1y year if tier_quartile==1, sort) ///
       (line mean_tier_hex1y year if tier_quartile==2, sort) ///
       (line mean_tier_hex1y year if tier_quartile==3, sort) ///
       (line mean_tier_hex1y year if tier_quartile==4, sort), ///
       legend(label(1 "Q1 (Lowest Restrictions)") ///
              label(2 "Q2") ///
              label(3 "Q3") ///
              label(4 "Q4 (Highest Restrictions)")) ///
       xline(2020) xlabel(2014(1)2025) ///
       title("Hexavalent at 1 Year Coverage Rates by Tier Severity") ///
       name(g_hex1y, replace)


**# hex_2y
bysort tier_quartile year: egen mean_tier_hex2y = mean(hex_2y)

twoway (line mean_tier_hex2y year if tier_quartile==1, sort) ///
       (line mean_tier_hex2y year if tier_quartile==2, sort) ///
       (line mean_tier_hex2y year if tier_quartile==3, sort) ///
       (line mean_tier_hex2y year if tier_quartile==4, sort), ///
       legend(label(1 "Q1 (Lowest Restrictions)") ///
              label(2 "Q2") ///
              label(3 "Q3") ///
              label(4 "Q4 (Highest Restrictions)")) ///
       xline(2020) xlabel(2014(1)2025) ///
       title("Hexavalent at 2 Years Coverage Rates by Tier Severity") ///
       name(g_hex2y, replace)


**# mmr1_2y
bysort tier_quartile year: egen mean_tier_mmr1_2y = mean(mmr1_2y)

twoway (line mean_tier_mmr1_2y year if tier_quartile==1, sort) ///
       (line mean_tier_mmr1_2y year if tier_quartile==2, sort) ///
       (line mean_tier_mmr1_2y year if tier_quartile==3, sort) ///
       (line mean_tier_mmr1_2y year if tier_quartile==4, sort), ///
       legend(label(1 "Q1 (Lowest Restrictions)") ///
              label(2 "Q2") ///
              label(3 "Q3") ///
              label(4 "Q4 (Highest Restrictions)")) ///
       xline(2020) xlabel(2014(1)2025) ///
       title("MMR1 at 2 Years Coverage Rates by Tier Severity") ///
       name(g_mmr1_2y, replace)


**# hib_men_boost_2y
bysort tier_quartile year: egen mean_tier_hib2y = mean(hib_men_boost_2y)

twoway (line mean_tier_hib2y year if tier_quartile==1, sort) ///
       (line mean_tier_hib2y year if tier_quartile==2, sort) ///
       (line mean_tier_hib2y year if tier_quartile==3, sort) ///
       (line mean_tier_hib2y year if tier_quartile==4, sort), ///
       legend(label(1 "Q1 (Lowest Restrictions)") ///
              label(2 "Q2") ///
              label(3 "Q3") ///
              label(4 "Q4 (Highest Restrictions)")) ///
       xline(2020) xlabel(2014(1)2025) ///
       title("Hib/MenC Booster at 2 Years Coverage Rates by Tier Severity") ///
       name(g_hib2y, replace)


**# hex_5y
bysort tier_quartile year: egen mean_tier_hex5y = mean(hex_5y)

twoway (line mean_tier_hex5y year if tier_quartile==1, sort) ///
       (line mean_tier_hex5y year if tier_quartile==2, sort) ///
       (line mean_tier_hex5y year if tier_quartile==3, sort) ///
       (line mean_tier_hex5y year if tier_quartile==4, sort), ///
       legend(label(1 "Q1 (Lowest Restrictions)") ///
              label(2 "Q2") ///
              label(3 "Q3") ///
              label(4 "Q4 (Highest Restrictions)")) ///
       xline(2020) xlabel(2014(1)2025) ///
       title("Hexavalent at 5 Years Coverage Rates by Tier Severity") ///
       name(g_hex5y, replace)


**# dtp_boost_5y
bysort tier_quartile year: egen mean_tier_dtpboost5y = mean(dtp_boost_5y)

twoway (line mean_tier_dtpboost5y year if tier_quartile==1, sort) ///
       (line mean_tier_dtpboost5y year if tier_quartile==2, sort) ///
       (line mean_tier_dtpboost5y year if tier_quartile==3, sort) ///
       (line mean_tier_dtpboost5y year if tier_quartile==4, sort), ///
       legend(label(1 "Q1 (Lowest Restrictions)") ///
              label(2 "Q2") ///
              label(3 "Q3") ///
              label(4 "Q4 (Highest Restrictions)")) ///
       xline(2020) xlabel(2014(1)2025) ///
       title("DTaP/IPV Booster at 5 Years Coverage Rates by Tier Severity") ///
       name(g_dtpboost5y, replace)


**# mmr1_5y
bysort tier_quartile year: egen mean_tier_mmr1_5y = mean(mmr1_5y)

twoway (line mean_tier_mmr1_5y year if tier_quartile==1, sort) ///
       (line mean_tier_mmr1_5y year if tier_quartile==2, sort) ///
       (line mean_tier_mmr1_5y year if tier_quartile==3, sort) ///
       (line mean_tier_mmr1_5y year if tier_quartile==4, sort), ///
       legend(label(1 "Q1 (Lowest Restrictions)") ///
              label(2 "Q2") ///
              label(3 "Q3") ///
              label(4 "Q4 (Highest Restrictions)")) ///
       xline(2020) xlabel(2014(1)2025) ///
       title("MMR1 at 5 Years Coverage Rates by Tier Severity") ///
       name(g_mmr1_5y, replace)


**# mmr2_5y
bysort tier_quartile year: egen mean_tier_mmr2_5y = mean(mmr2_5y)

twoway (line mean_tier_mmr2_5y year if tier_quartile==1, sort) ///
       (line mean_tier_mmr2_5y year if tier_quartile==2, sort) ///
       (line mean_tier_mmr2_5y year if tier_quartile==3, sort) ///
       (line mean_tier_mmr2_5y year if tier_quartile==4, sort), ///
       legend(label(1 "Q1 (Lowest Restrictions)") ///
              label(2 "Q2") ///
              label(3 "Q3") ///
              label(4 "Q4 (Highest Restrictions)")) ///
       xline(2020) xlabel(2014(1)2025) ///
       title("MMR2 at 5 Years Coverage Rates by Tier Severity") ///
       name(g_mmr2_5y, replace)


**# hib_men_boost_5y
bysort tier_quartile year: egen mean_tier_hib5y = mean(hib_men_boost_5y)

twoway (line mean_tier_hib5y year if tier_quartile==1, sort) ///
       (line mean_tier_hib5y year if tier_quartile==2, sort) ///
       (line mean_tier_hib5y year if tier_quartile==3, sort) ///
       (line mean_tier_hib5y year if tier_quartile==4, sort), ///
       legend(label(1 "Q1 (Lowest Restrictions)") ///
              label(2 "Q2") ///
              label(3 "Q3") ///
              label(4 "Q4 (Highest Restrictions)")) ///
       xline(2020) xlabel(2014(1)2025) ///
       title("Hib/MenC Booster at 5 Years Coverage Rates by Tier Severity") ///
       name(g_hib5y, replace)



**# COMBINE GRAPHS ACROSS THREE PAGES, WITH SMALLER TEXT FOR LEGIBILITY

* iscale() shrinks title/legend/axis text and markers relative to the plot
* box (it does not resize the plot itself). Lower the multiplier further
* (e.g. *.4) if still too cramped, or raise it (e.g. *.7) if too small.


**# Page 1 of 3: hex_1y, hex_2y, mmr1_2y
graph combine g_hex1y g_hex2y g_mmr1_2y, ///
    rows(2) cols(2) ///
    iscale(*.55) ///
    title("Parallel Trends (1 of 3): Vaccination Uptake by Tier Exposure Quartile, 2014-2025") ///
    name(combined_trends_p1, replace)

graph export "parallel_trends_page1.png", ///
    name(combined_trends_p1) width(2400) replace


**# Page 2 of 3: hib_men_boost_2y, hex_5y, dtp_boost_5y
graph combine g_hib2y g_hex5y g_dtpboost5y, ///
    rows(2) cols(2) ///
    iscale(*.55) ///
    title("Parallel Trends (2 of 3): Vaccination Uptake by Tier Exposure Quartile, 2014-2025") ///
    name(combined_trends_p2, replace)

graph export "parallel_trends_page2.png", ///
    name(combined_trends_p2) width(2400) replace


**# Page 3 of 3: mmr1_5y, mmr2_5y, hib_men_boost_5y
graph combine g_mmr1_5y g_mmr2_5y g_hib5y, ///
    rows(2) cols(2) ///
    iscale(*.55) ///
    title("Parallel Trends (3 of 3): Vaccination Uptake by Tier Exposure Quartile, 2014-2025") ///
    name(combined_trends_p3, replace)

graph export "parallel_trends_page3.png", ///
    name(combined_trends_p3) width(2400) replace
```
