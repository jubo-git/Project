```stata
**# 0 GitHub Setup
use "https://raw.githubusercontent.com/jubo-git/Project/main/2.%20data_clean/full_dataset.dta", clear

**# 0.1 Define Panel Structure
xtset ons_id year


********************************************************************************
**# PRIMARY CONTINUOUS cDiD MODELS (LA FE + Year FE) — Table 2
********************************************************************************

**# Model 1.1: Tier — Hexavalent at 1 year
xtreg hex_1y c.total_tier#i.post i.year, fe vce(cluster onscode)

**# Model 2.1: Tier — Hexavalent at 2 years
xtreg hex_2y c.total_tier#i.post i.year, fe vce(cluster onscode)

**# Model 3.1: Tier — MMR1 at 2 years
xtreg mmr1_2y c.total_tier#i.post i.year, fe vce(cluster onscode)

**# Model 4.1: Tier — Hib/MenC Booster at 2 years
xtreg hib_men_boost_2y c.total_tier#i.post i.year, fe vce(cluster onscode)

**# Model 5.1: Tier — Hexavalent at 5 years
xtreg hex_5y c.total_tier#i.post i.year, fe vce(cluster onscode)

**# Model 6.1: Tier — DTP Booster at 5 years
xtreg dtp_boost_5y c.total_tier#i.post i.year, fe vce(cluster onscode)

**# Model 7.1: Tier — MMR1 at 5 years
xtreg mmr1_5y c.total_tier#i.post i.year, fe vce(cluster onscode)

**# Model 8.1: Tier — MMR2 at 5 years
xtreg mmr2_5y c.total_tier#i.post i.year, fe vce(cluster onscode)

**# Model 9.1: Tier — Hib/MenC Booster at 5 years
xtreg hib_men_boost_5y c.total_tier#i.post i.year, fe vce(cluster onscode)



********************************************************************************
**# NON-LINEAR DOSE-RESPONSE CHECK (Quadratic Term)
********************************************************************************

**# Model 1.2: Tier — Hexavalent at 1 year
xtreg hex_1y c.total_tier#i.post ///
    c.total_tier#c.total_tier#i.post i.year, ///
    fe vce(cluster onscode)

**# Model 2.2: Tier — Hexavalent at 2 years
xtreg hex_2y c.total_tier#i.post ///
    c.total_tier#c.total_tier#i.post i.year, ///
    fe vce(cluster onscode)

**# Model 3.2: Tier — MMR1 at 2 years
xtreg mmr1_2y c.total_tier#i.post ///
    c.total_tier#c.total_tier#i.post i.year, ///
    fe vce(cluster onscode)

**# Model 4.2: Tier — Hib/MenC Booster at 2 years
xtreg hib_men_boost_2y c.total_tier#i.post ///
    c.total_tier#c.total_tier#i.post i.year, ///
    fe vce(cluster onscode)

**# Model 5.2: Tier — Hexavalent at 5 years
xtreg hex_5y c.total_tier#i.post ///
    c.total_tier#c.total_tier#i.post i.year, ///
    fe vce(cluster onscode)

**# Model 6.2: Tier — DTP Booster at 5 years
xtreg dtp_boost_5y c.total_tier#i.post ///
    c.total_tier#c.total_tier#i.post i.year, ///
    fe vce(cluster onscode)

**# Model 7.2: Tier — MMR1 at 5 years
xtreg mmr1_5y c.total_tier#i.post ///
    c.total_tier#c.total_tier#i.post i.year, ///
    fe vce(cluster onscode)

**# Model 8.2: Tier — MMR2 at 5 years
xtreg mmr2_5y c.total_tier#i.post ///
    c.total_tier#c.total_tier#i.post i.year, ///
    fe vce(cluster onscode)

**# Model 9.2: Tier — Hib/MenC Booster at 5 years
xtreg hib_men_boost_5y c.total_tier#i.post ///
    c.total_tier#c.total_tier#i.post i.year, ///
    fe vce(cluster onscode)



********************************************************************************
**# POOLED OLS WITH NOMIS CONTROLS + VIF — Table 6
********************************************************************************

**# Model 1.3: Tier — Hexavalent at 1 year
regress hex_1y c.total_tier#i.post ///
    asian_pct black_pct mixed_pct other_pct ///
    hh_deprived_1_pct hh_deprived_2_pct hh_deprived_3_pct hh_deprived_4_pct ///
    christian_pct buddhist_pct hindu_pct jewish_pct muslim_pct ///
    sikh_pct otherreligion_pct i.year, ///
    vce(cluster onscode)
estat vif

**# Model 2.3: Tier — Hexavalent at 2 years
regress hex_2y c.total_tier#i.post ///
    asian_pct black_pct mixed_pct other_pct ///
    hh_deprived_1_pct hh_deprived_2_pct hh_deprived_3_pct hh_deprived_4_pct ///
    christian_pct buddhist_pct hindu_pct jewish_pct muslim_pct ///
    sikh_pct otherreligion_pct i.year, ///
    vce(cluster onscode)
estat vif

**# Model 3.3: Tier — MMR1 at 2 years
regress mmr1_2y c.total_tier#i.post ///
    asian_pct black_pct mixed_pct other_pct ///
    hh_deprived_1_pct hh_deprived_2_pct hh_deprived_3_pct hh_deprived_4_pct ///
    christian_pct buddhist_pct hindu_pct jewish_pct muslim_pct ///
    sikh_pct otherreligion_pct i.year, ///
    vce(cluster onscode)
estat vif

**# Model 4.3: Tier — Hib/MenC Booster at 2 years
regress hib_men_boost_2y c.total_tier#i.post ///
    asian_pct black_pct mixed_pct other_pct ///
    hh_deprived_1_pct hh_deprived_2_pct hh_deprived_3_pct hh_deprived_4_pct ///
    christian_pct buddhist_pct hindu_pct jewish_pct muslim_pct ///
    sikh_pct otherreligion_pct i.year, ///
    vce(cluster onscode)
estat vif

**# Model 5.3: Tier — Hexavalent at 5 years
regress hex_5y c.total_tier#i.post ///
    asian_pct black_pct mixed_pct other_pct ///
    hh_deprived_1_pct hh_deprived_2_pct hh_deprived_3_pct hh_deprived_4_pct ///
    christian_pct buddhist_pct hindu_pct jewish_pct muslim_pct ///
    sikh_pct otherreligion_pct i.year, ///
    vce(cluster onscode)
estat vif

**# Model 6.3: Tier — DTP Booster at 5 years
regress dtp_boost_5y c.total_tier#i.post ///
    asian_pct black_pct mixed_pct other_pct ///
    hh_deprived_1_pct hh_deprived_2_pct hh_deprived_3_pct hh_deprived_4_pct ///
    christian_pct buddhist_pct hindu_pct jewish_pct muslim_pct ///
    sikh_pct otherreligion_pct i.year, ///
    vce(cluster onscode)
estat vif

**# Model 7.3: Tier — MMR1 at 5 years
regress mmr1_5y c.total_tier#i.post ///
    asian_pct black_pct mixed_pct other_pct ///
    hh_deprived_1_pct hh_deprived_2_pct hh_deprived_3_pct hh_deprived_4_pct ///
    christian_pct buddhist_pct hindu_pct jewish_pct muslim_pct ///
    sikh_pct otherreligion_pct i.year, ///
    vce(cluster onscode)
estat vif

**# Model 8.3: Tier — MMR2 at 5 years
regress mmr2_5y c.total_tier#i.post ///
    asian_pct black_pct mixed_pct other_pct ///
    hh_deprived_1_pct hh_deprived_2_pct hh_deprived_3_pct hh_deprived_4_pct ///
    christian_pct buddhist_pct hindu_pct jewish_pct muslim_pct ///
    sikh_pct otherreligion_pct i.year, ///
    vce(cluster onscode)
estat vif

**# Model 9.3: Tier — Hib/MenC Booster at 5 years
regress hib_men_boost_5y c.total_tier#i.post ///
    asian_pct black_pct mixed_pct other_pct ///
    hh_deprived_1_pct hh_deprived_2_pct hh_deprived_3_pct hh_deprived_4_pct ///
    christian_pct buddhist_pct hindu_pct jewish_pct muslim_pct ///
    sikh_pct otherreligion_pct i.year, ///
    vce(cluster onscode)
estat vif



********************************************************************************
**# SENSITIVITY / ROBUSTNESS CHECK — QUARTILE MODEL
* Threshold Effects: Tier Exposure Quartiles
* Q1 = Lowest cumulative tier exposure
* Q4 = Highest cumulative tier exposure
********************************************************************************

**# Quartile Model 1: Hexavalent at 1 year
xtreg hex_1y ib1.tier_quartile#1.post i.year, ///
    fe vce(cluster onscode)

**# Quartile Model 2: Hexavalent at 2 years
xtreg hex_2y ib1.tier_quartile#1.post i.year, ///
    fe vce(cluster onscode)

**# Quartile Model 3: MMR1 at 2 years
xtreg mmr1_2y ib1.tier_quartile#1.post i.year, ///
    fe vce(cluster onscode)

**# Quartile Model 4: Hib/MenC Booster at 2 years
xtreg hib_men_boost_2y ib1.tier_quartile#1.post i.year, ///
    fe vce(cluster onscode)

**# Quartile Model 5: Hexavalent at 5 years
xtreg hex_5y ib1.tier_quartile#1.post i.year, ///
    fe vce(cluster onscode)

**# Quartile Model 6: DTP Booster at 5 years
xtreg dtp_boost_5y ib1.tier_quartile#1.post i.year, ///
    fe vce(cluster onscode)

**# Quartile Model 7: MMR1 at 5 years
xtreg mmr1_5y ib1.tier_quartile#1.post i.year, ///
    fe vce(cluster onscode)

**# Quartile Model 8: MMR2 at 5 years
xtreg mmr2_5y ib1.tier_quartile#1.post i.year, ///
    fe vce(cluster onscode)

**# Quartile Model 9: Hib/MenC Booster at 5 years
xtreg hib_men_boost_5y ib1.tier_quartile#1.post i.year, ///
    fe vce(cluster onscode)


**# Marginal Effects for Quartile Model
margins tier_quartile#post
marginsplot



********************************************************************************
**# 6. SAVE / VERSION CONTROL
********************************************************************************

//Saving
!git pull
!git add .
!git commit -m "DiD Model Update - corrected vaccine variable names and quartile robustness checks"
!git push -u origin main
```
