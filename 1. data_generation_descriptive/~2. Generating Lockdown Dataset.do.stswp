**#1 Processing Lockdown Data to be Comp. with Vaccine Data
** import ALL raw lockdown data from the public web repository
local repo "https://raw.githubusercontent.com/jubo-git/Project/main/0.%20data_raw_excel"
copy "`repo'/Lockdown%20Data/Covid-local-restrictions-dataset.xlsx" "temp_main.xlsx", replace
import excel "temp_main.xlsx", sheet("dataset") firstrow clear

** Tidying (generic and making variables more streamlined)


	* maintain english data only 
	drop Scotlandtier
	drop if Country !="England"

	rename *, lower
	rename englandtiera tiera
	rename englandtierb tierb
	rename noindoormixing noindoormix
	rename nooutdoormixing nooutmix
	rename lacode onscode
	encode ons, gen(ons_id)

	* create a date function (to allow for averages later)
	gen date = mdy(month,dayofmonth,2020)
	format date %td
	label variable date "Date of Restriction"
	drop month dayofmonth 
	

	* need to rename LOCKDOWN data E10000002 to E06000060 as code changed in 2021
	replace onscode = "E06000060" if onscode == "E10000002" // Buckinhamshire code change 
	replace onscode = "E06000065" if onscode == "E10000023" // North Yorkshire code change 
	replace onscode = "E06000066" if onscode == "E10000027" // Somerset code change

	
** COMBINING LOCAL AUTHORITY DATA
	replace onscode = countycode if inlist(onscode, ///
	"E11000001", "E11000002", "E11000003" /// /Great Manchester, Merseyside, South Yorkshire,
	"E11000005", "E11000006", /// West Midlands, Tyne and Wear,
	"E11000007", "E13000001", "E13000002") //  Inner London, Outer London 

		**sorting date to be reflective of actual restriction timeline 
	drop if date >= td(01jan2020) & date <= td(21mar2020) //When COVID started nothing of value in this period 
	
	*Duplicate Dec 31 rows 5 additional times (creates 6 identical rows total per LA)
	preserve
	keep if date == td(31dec2020)
	expand 6

	*Re-assign dates from Dec 31st up to Jan 5th across the duplicated rows
	by laname, sort: gen new_date = td(31dec2020) + _n - 1
	format new_date %td

	* Replace original date variable and save as temporary file
	drop date
	rename new_date date
	tempfile jan_extension
	save `jan_extension'

	* Restore original data, remove Dec 31 to prevent duplicate keys, and append extension
	restore
	drop if date == td(31dec2020)
	append using `jan_extension'
	sort laname date
		
	*Check for duplicates 
	tab onscode
	
**# Diagnostic before defining variables (including timelines)
		
		**Diagnostics
		//summary statisitics for each variable 
		//time variation to see when policies turned on/off
		//within-LA starndard deviation


	**Social Distancing 
		summarize socialdistancing //shows min and max both 1 with a sd of 0	
		
	**Primary 
		summarize primaryclosed // shows std of 0.43
		bysort laname: egen sd_primary = sd(primaryclosed)
		tab sd_primary //does not show spatial variation as 100% of the values have the same distrubution
		tab laname primaryclosed
		
	**Secondary School Closures	
		summarize secondaryclosed 
		bysort laname: egen sd_secondary = sd(secondaryclosed)
		tab sd_secondary //shows variation but only in 1 LA
		tab laname sd_secondary //verified that only Lecister so no meaningful variation 
		
	**Hospitality Shutdown
		summarize hospitalityshut
		bysort laname: egen sd_hospitality = sd(hospitalityshut)
		tab sd_hospitality //shows variation 
		tab laname sd_hospitality //shows three LA with variation 

	**Retail Shutdown
		summarize retailshut
		bysort laname: egen sd_retail = sd(retailshut)
		tab sd_retail // shows spatial variation
		tab laname sd_retail //verified across multiple LA
		
	**Tier A 
		sum tiera
		tab date tiera
		bysort laname: egen sd_tiera = sd(tiera)
		tab sd_tiera		
		tab laname tiera
	
	**Tier B 
		sum tierb
		tab date tierb
		bysort laname: egen sd_tierb = sd(tierb)
		tab sd_tierb	
		tab laname tierb
		
	//Reveals that social distancing, primary, secondary hospitality had very little national variation. Just retail shutdown, tier a and tier b. Not using tiers as a weighting factor as it disguses national trends. Not possible or neccessary to build a total score.

	**From lockdown dataset information Tier A and Tier B were a concurrent scheme. Verified below 
	tab date tiera
	tab date tierb
	
	**Tier A runs 14th of October - 4th November and Tier B runs 2nd December to 1st of Jan. They are therefore combined into one tier variable 
	
**# 3 Creating Lockdown Dataset 

	* combine the tiers as concurrent and on the same scale
		egen tier = rowfirst(tiera tierb) //note this works
		tab laname tier // verify reflects lockdown timelines

	* Per Tier Daily Count (BINARY)
		gen days_tier1 = (tier == 1)
		gen days_tier2 = (tier == 2)
		gen days_tier3 = (tier == 3)
		gen days_tier4 = (tier == 4)
		
	cd "C:\Users\44799\OneDrive - MMU\03 DISSERTATION\GITHUB\
	use "2. data_clean\duplicate_check.dta", clear
		
*Accounts for all the sub-districts thatr don't match vaccine data and have no extra data
	collapse (max) tier days_tier1 days_tier2 days_tier3 days_tier4 retailshut, by(onscode date)

*collapse by Local Authority to capture the total cumulative duration x severity
	collapse (sum) total_tier1 = days_tier1 ///
			 (sum) total_tier2 = days_tier2 ///
			 (sum) total_tier3 = days_tier3 ///
			 (sum) total_tier4 = days_tier4 ///
			 (sum) total_tier = tier ///
			 (sum) total_retail = retailshut, by(onscode)

	
	* quintiles
	xtile tier_quintile   = total_tier, nquantiles(5)
	xtile retail_quintile = total_retail, nquantiles(5)
		
		//Hospitality dropped: diagnostic showed near-zero cross-LA variation
		//Retail retained as sole Complacency proxy - confirmed genuine local variation.
		//Note: Convenience (primary/secondary school closures) dropped entirely. Diagnostic showed 99.34% of LAs identical on both total_days_closed (72 days) and total_days_secondary (86 days) - closures were applied near-nationally
		
	
	* Drop specific areas not reflected in Vaccine Data 
	drop if inlist(onscode, "E06000017", "E06000053", "E09000001", "E07000188")
	//cd "C:\Users\44799\OneDrive - MMU\03 DISSERTATION\GITHUB\"
	save "2. data_clean\lockdown_dataset.dta", replace

